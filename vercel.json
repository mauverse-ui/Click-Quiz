{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/feed",     "destination": "/feed.xml" },
    { "source": "/rss",      "destination": "/feed.xml" },
    { "source": "/rss.xml",  "destination": "/feed.xml" },
    { "source": "/atom.xml", "destination": "/feed.xml" }
  ],
  "headers": [
    {
      "source": "/feed.xml",
      "headers": [
        { "key": "Content-Type",  "value": "application/rss+xml; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=600" }
      ]
    },
    {
      "source": "/(feed|rss|rss.xml|atom.xml)",
      "headers": [
        { "key": "Content-Type",  "value": "application/rss+xml; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=600" }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type",  "value": "application/xml; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    }
  ]
}
